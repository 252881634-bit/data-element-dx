<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '44px 60px 0 60px' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#062032', lineHeight: 1.28 }}>
        确权是所有对外动作的唯一前置
    </Text>
    <Box style={{ width: 1160, height: 1, background: '#000000', marginTop: 12 }} />

    <Box style={{ flexDirection: 'row', gap: 30, marginTop: 28 }}>
        <Box style={{ flex: 1, flexDirection: 'column', background: '#F2F5F3', padding: 24 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#44546A', letterSpacing: 2 }}>不做确权会怎样</Text>
            <Box style={{ flexDirection: 'column', gap: 14, marginTop: 18 }}>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#808080', fontWeight: 'bold' }}>—</Text>
                    <Text style={{ fontSize: 19, color: '#333333', lineHeight: 1.45 }}>
                        对外产品无法上线，价格指数发布没有法理基础
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#808080', fontWeight: 'bold' }}>—</Text>
                    <Text style={{ fontSize: 19, color: '#333333', lineHeight: 1.45 }}>
                        数据资产<span style={{ fontWeight: 'bold' }}>无法入表</span>，账面价值始终是零
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#808080', fontWeight: 'bold' }}>—</Text>
                    <Text style={{ fontSize: 19, color: '#333333', lineHeight: 1.45 }}>
                        商户权益边界模糊，一旦争议将面临法律风险
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#808080', fontWeight: 'bold' }}>—</Text>
                    <Text style={{ fontSize: 19, color: '#333333', lineHeight: 1.45 }}>
                        数据交易、授权、融资合作全部<span style={{ fontWeight: 'bold' }}>无从谈起</span>
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flex: 1, flexDirection: 'column', background: '#1F4E35', padding: 24 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#9FD8BC', letterSpacing: 2 }}>做完确权能打开什么</Text>
            <Box style={{ flexDirection: 'column', gap: 14, marginTop: 18 }}>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#7FB89E', fontWeight: 'bold' }}>+</Text>
                    <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.45 }}>
                        对外数据产品具备合规基础，指数发布可推进
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#7FB89E', fontWeight: 'bold' }}>+</Text>
                    <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.45 }}>
                        入表路径打通，数据从"成本"变成<span style={{ fontWeight: 'bold' }}>可计量资产</span>
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#7FB89E', fontWeight: 'bold' }}>+</Text>
                    <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.45 }}>
                        商户权益规则清晰，聚合数据可安全对外
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 20, color: '#7FB89E', fontWeight: 'bold' }}>+</Text>
                    <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.45 }}>
                        数据源授权与金融合作具备谈判资格
                    </Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ marginTop: 24, background: '#F2F5F3', borderRadius: 4, padding: '18px 24px', flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F4E35', lineHeight: 1 }}>3–6 月</Text>
        <Box style={{ width: 1, height: 44, background: '#C4DBCF' }} />
        <Text style={{ fontSize: 19, color: '#062032', lineHeight: 1.45, flex: 1 }}>
            确权专项预计周期 ｜ <span style={{ fontWeight: 'bold' }}>建议作为集团数据工作的第一优先级任务</span>，并配法务专职参与
        </Text>
    </Box>

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 20 }}>
        <Text style={{ fontSize: 14, color: '#808080' }}>Source: 数据资产入表路径建议（依据财政部《企业数据资源相关会计处理暂行规定》）</Text>
        <Text style={{ fontSize: 14, color: '#808080' }}>19</Text>
    </Box>
</Slide>
